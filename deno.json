{
  "license": "MIT",
  "workspace": {
    "members": [
      "packages/cli",
      "packages/core",
      "packages/ext",
      "packages/wasm"
    ]
  },
  "imports": {
    "@david/dax": "jsr:@david/dax@0.42.0",
    "debrotli": "npm:debrotli@^0.1.0"
  },
  "tasks": {
    "test": "deno test -A --no-check=remote --parallel --doc --clean --coverage=.coverage --permit-no-files",
    "test:nocheck": "deno test -A --no-check --parallel --doc --clean --coverage=.coverage --permit-no-files",
    "coverage:lcov": "deno coverage --lcov --output=.coverage/lcov.info .coverage",
    "coverage:html": "deno coverage --html .coverage",
    "coverage": "deno run coverage:lcov && deno run coverage:html",
    "build:base": "deno -Aq jsr:@deno/wasmbuild@0.19.1 build -p lint",
    "build:wasm": "deno task build:base --out packages/wasm/lib",
    "build:sync": "deno task build:base --out packages/wasm --inline && deno task compress ./packages/wasm/lib/lint.js",
    "build:lite": "deno task build:base --out packages/wasm/lib-lite --inline --no-default-features --features lite && deno task compress ./packages/wasm/lib-lite/lint.js",
    "compress": "deno run -qA scripts/compress_wasm.ts",
    "build": "deno task build:wasm && deno task build:sync && deno task build:lite"
  },
  "unstable": ["cron", "kv", "node-globals"],
  "publish": {
    "include": [
      "packages/**/*.ts",
      "packages/**/*.js*",
      "packages/*/README.md",
      "packages/*/LICENSE"
    ],
    "exclude": ["**/*.test.*", "**/*.bench.*", "**/testdata", "**/.*", "**/__*"]
  },
  "exclude": [
    "**/.coverage",
    "**/testdata",
    "**/__*"
  ]
}
